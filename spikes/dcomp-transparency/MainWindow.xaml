<Window x:Class="DcompSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DcompSpike"
        Title="DcompSpike" Width="900" Height="600" Left="2000" Top="100"
        Background="Transparent" WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <!-- WPF chrome band: translucent like OverShell's caption -->
        <Border Grid.Row="0" Background="#A6171A20">
            <TextBlock x:Name="Caption" Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="12,0" Text="WPF caption (translucent over the backdrop)" />
        </Border>
        <!-- WPF content that the child window covers; visible only where the child lets it through -->
        <Grid Grid.Row="1">
            <Border Background="#8020C020" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,120,0,0" Padding="12,6" Panel.ZIndex="5"><TextBlock Foreground="White" FontSize="26" FontWeight="Bold" Text="WPF over the terminal (toast / find highlight)" /></Border>
            <Border x:Name="HostBorder" Margin="24" BorderBrush="#FFFFD740" BorderThickness="2">
                <local:ChildHost x:Name="Host" />
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#A6171A20">
            <TextBlock x:Name="Status" Foreground="#FFB0B0B0" FontSize="13" VerticalAlignment="Center" Margin="12,0" />
        </Border>
    </Grid>
</Window>
