<Window x:Class="OverShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:OverShell.App"
        Title="OverShell"
        Height="760"
        Width="1180"
        MinHeight="320"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness must stay 0: any other value hands the non-client frame
             to DWM, which then draws its own caption buttons over ours and turns the
             whole client area into glass. The backdrop is extended manually instead,
             over the chrome bands only — see WindowChromeInterop. -->
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowRoot"
            Background="Transparent"
            BorderBrush="{StaticResource Surface.Border}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================= Title bar + tabs ======================= -->
            <Border x:Name="TitleBarSurface"
                    Grid.Row="0"
                    Height="{StaticResource Metrics.TitleBarHeight}"
                    Background="{StaticResource Surface.Chrome}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- brand mark -->
                    <Border Grid.Column="0"
                            Width="42"
                            VerticalAlignment="Stretch"
                            Background="Transparent">
                        <Border Width="16" Height="16"
                                CornerRadius="4"
                                Background="{StaticResource Accent.Base}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="9"
                                       Foreground="#FF0B1020"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Border>

                    <!-- tab strip; the + button rides along right after the last tab -->
                    <ScrollViewer Grid.Column="1"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Left"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TerminalTab}">
                                    <!-- Rich tab item (§12.5): state dot with motion, harness glyph, two
                                         lines (label / state · project), unread badge, progress bar. -->
                                    <Border x:Name="TabRoot"
                                            MinWidth="150"
                                            MaxWidth="240"
                                            Height="{StaticResource Metrics.TabHeight}"
                                            Margin="0,0,2,0"
                                            CornerRadius="{StaticResource Metrics.TabCorner}"
                                            Background="Transparent"
                                            MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                            MouseDown="Tab_MouseDown"
                                            ToolTip="{Binding Tooltip}">
                                        <Grid>
                                            <!-- active indicator -->
                                            <Border x:Name="ActiveBar"
                                                    Height="2"
                                                    VerticalAlignment="Top"
                                                    Margin="10,0"
                                                    CornerRadius="1"
                                                    Background="{Binding Accent}"
                                                    Visibility="Collapsed" />

                                            <Grid Margin="11,0,7,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- state dot: profile accent for a plain shell, state colour once known -->
                                                <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Border x:Name="BlockedRing"
                                                            Width="14" Height="14"
                                                            CornerRadius="7"
                                                            BorderThickness="1.5"
                                                            BorderBrush="{StaticResource State.Blocked}"
                                                            Visibility="Collapsed" />
                                                    <Border x:Name="StateDot"
                                                            Width="8" Height="8"
                                                            CornerRadius="4"
                                                            Background="{Binding Accent}" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="TabGlyph"
                                                                   Text="{Binding Glyph}"
                                                                   Margin="0,0,5,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Secondary}"
                                                                   Visibility="Collapsed" />
                                                        <TextBlock x:Name="TabLabel"
                                                                   Text="{Binding Label}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontFamily="{StaticResource Font.Ui}"
                                                                   FontSize="{StaticResource Font.Size.Body}"
                                                                   Foreground="{StaticResource Text.Secondary}" />
                                                        <Border x:Name="UnreadBadge"
                                                                Width="6" Height="6"
                                                                Margin="6,0,0,0"
                                                                CornerRadius="3"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding StateBrush}"
                                                                Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TabDetail"
                                                               Text="{Binding Detail}"
                                                               Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontFamily="{StaticResource Font.Ui}"
                                                               FontSize="{StaticResource Font.Size.Detail}"
                                                               Foreground="{StaticResource Text.Disabled}" />
                                                </StackPanel>

                                                <Button x:Name="TabClose"
                                                        Grid.Column="2"
                                                        Width="20" Height="20"
                                                        Margin="7,0,0,0"
                                                        Content="&#xE8BB;"
                                                        FontSize="8"
                                                        Opacity="0"
                                                        Style="{StaticResource ChromeIconButton}"
                                                        Click="CloseTab_Click" />
                                            </Grid>

                                            <!-- OSC 9;4 progress, when the program reports one -->
                                            <ProgressBar x:Name="TabProgress"
                                                         Height="2"
                                                         Margin="10,0,10,1"
                                                         VerticalAlignment="Bottom"
                                                         Minimum="0" Maximum="1"
                                                         Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"
                                                         IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                                         Foreground="{Binding StateBrush}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background" Value="{Binding Background}" />
                                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Primary}" />
                                            <Setter TargetName="TabLabel" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                            <Setter TargetName="TabClose" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabClose" Property="Opacity" Value="1" />
                                            <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Primary}" />
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsActive}" Value="False" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Surface.Hover}" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                            <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Disabled}" />
                                            <Setter TargetName="TabLabel" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>

                                        <!-- agent chrome -->
                                        <DataTrigger Binding="{Binding IsAgent}" Value="True">
                                            <Setter TargetName="TabGlyph" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Working">
                                            <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Working}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="WorkingPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="StateDot"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.35" Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="WorkingPulse" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Blocked">
                                            <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Blocked}" />
                                            <Setter TargetName="BlockedRing" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Blocked}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Done}" />
                                            <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Done}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Error}" />
                                            <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Idle">
                                            <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Idle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Exited">
                                            <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Exited}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Unread}" Value="True">
                                            <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ProgressIndeterminate}" Value="True">
                                            <Setter TargetName="TabProgress" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Progress, Converter={StaticResource IsNotNull}}" Value="True">
                                            <Setter TargetName="TabProgress" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="BtnNewTab"
                                    Content="&#xE710;"
                                    Margin="4,0,0,1"
                                    VerticalAlignment="Center"
                                    ToolTip="New tab  (Ctrl+T)"
                                    Style="{StaticResource ChromeIconButton}"
                                    Click="NewTab_Click" />
                            <Button x:Name="BtnProfiles"
                                    Content="&#xE70D;"
                                    FontSize="9"
                                    Width="22"
                                    Margin="1,0,0,1"
                                    VerticalAlignment="Center"
                                    ToolTip="Open a specific profile"
                                    Style="{StaticResource ChromeIconButton}"
                                    Click="Profiles_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- caption buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" />
                        <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" />
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================= Terminal host ======================== -->
            <!-- Deliberately opaque: the text area reads as a solid panel with
                 translucent chrome above and below, matching useAcrylicInTabRow. -->
            <Grid x:Name="TerminalHost"
                  Grid.Row="1"
                  Background="{Binding ActiveTab.Background, FallbackValue={StaticResource Surface.Base}}" />

            <!-- =========================== Status bar ======================== -->
            <Border x:Name="StatusBarSurface"
                    Grid.Row="2"
                    Height="{StaticResource Metrics.StatusBarHeight}"
                    Background="{StaticResource Surface.Chrome}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6"
                                CornerRadius="3"
                                Margin="0,0,8,0"
                                Background="{Binding ActiveTab.Accent}" />
                        <TextBlock Text="{Binding ActiveTab.Profile.Name}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}" />
                    </StackPanel>

                    <TextBlock x:Name="TxtDetail"
                               Grid.Column="1"
                               Text="{Binding ActiveTab.StatusDetail}"
                               Margin="18,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Disabled}"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Small}" />

                    <!-- Transient message (command results, explain); takes the detail slot for a few seconds. -->
                    <TextBlock x:Name="TxtMessage"
                               Grid.Column="1"
                               Margin="18,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Secondary}"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Visibility="Collapsed" />

                    <!-- Link under the pointer while Ctrl is held; takes the detail slot. -->
                    <StackPanel x:Name="LinkHintPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="18,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="&#xE71B;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="10"
                                   Margin="0,1,7,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock x:Name="TxtLinkHint"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Herd counts: click jumps to the tab that needs you (tab.jumpToAttention). -->
                        <TextBlock x:Name="TxtAttention"
                                   Margin="0,0,18,0"
                                   Cursor="Hand"
                                   ToolTip="Jump to the tab that needs you  (Ctrl+Shift+J)"
                                   Foreground="{StaticResource Text.Disabled}"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   MouseLeftButtonDown="Attention_Click" />
                        <TextBlock x:Name="TxtGrid"
                                   Foreground="{StaticResource Text.Disabled}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource Font.Size.Small}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
