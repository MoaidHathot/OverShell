<Window x:Class="OverShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:chrome="clr-namespace:OverShell.App.Chrome"
        Title="OverShell"
        Height="760"
        Width="1180"
        MinHeight="320"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness must stay 0: any other value hands the non-client frame
             to DWM, which then draws its own caption buttons over ours and turns the
             whole client area into glass. The backdrop is extended manually instead,
             over the chrome bands only - see WindowChromeInterop. -->
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowRoot"
            Background="Transparent"
            BorderBrush="{StaticResource Surface.Border}"
            BorderThickness="1">

        <!-- Regions (§12.5). The terminal keeps the middle whatever the layout; the tab
             strip and the Herd sidebar are moved between the hosts around it. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================= Caption bar (+ tabs when on top) ======================= -->
            <Border x:Name="TitleBarSurface"
                    Grid.Row="0"
                    Height="{Binding CaptionHeight}"
                    Background="{StaticResource Surface.Chrome}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- brand mark -->
                    <Border Grid.Column="0"
                            Width="42"
                            VerticalAlignment="Stretch"
                            Background="Transparent">
                        <Border Width="16" Height="16"
                                CornerRadius="4"
                                Background="{StaticResource Accent.Base}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="9"
                                       Foreground="#FF0B1020"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Border>

                    <!-- the tab strip lives here in "top" layouts; otherwise the title -->
                    <Grid Grid.Column="1">
                        <ContentControl x:Name="CaptionTabsHost"
                                        Focusable="False"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBlock x:Name="TxtCaptionTitle"
                                   VerticalAlignment="Center"
                                   Margin="4,0"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Visibility="Collapsed" />
                    </Grid>

                    <chrome:ViewSwitch x:Name="ViewSwitch" Grid.Column="2" VerticalAlignment="Top" Margin="0,5,0,0" />

                    <!-- caption buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" />
                        <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" />
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Body ============================ -->
            <Grid x:Name="Body" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- side panels: a tab list and/or the Herd sidebar, side by side -->
                <StackPanel x:Name="LeftPanel" Grid.Column="0" Orientation="Horizontal" Background="{StaticResource Surface.Chrome}" />

                <Grid x:Name="MainHost" Grid.Column="1">
                    <!-- Deliberately opaque: the text area reads as a solid panel with
                         translucent chrome above and below, matching useAcrylicInTabRow. -->
                    <Grid x:Name="TerminalHost"
                          Background="{Binding ActiveTab.Background, FallbackValue={StaticResource Surface.Base}}" />
                    <chrome:DashboardView x:Name="Dashboard" Visibility="Collapsed" />
                </Grid>

                <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal" Background="{StaticResource Surface.Chrome}" />
            </Grid>

            <!-- ======================= Bottom tab strip (bottom layouts) ======================= -->
            <Border x:Name="BottomBar"
                    Grid.Row="2"
                    Background="{StaticResource Surface.Chrome}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <ContentControl x:Name="BottomTabsHost" Focusable="False" Margin="8,4,8,0" HorizontalAlignment="Left" />
            </Border>

            <!-- =========================== Status bar ======================== -->
            <Border x:Name="StatusBarSurface"
                    Grid.Row="3"
                    Height="{StaticResource Metrics.StatusBarHeight}"
                    Background="{StaticResource Surface.Chrome}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6"
                                CornerRadius="3"
                                Margin="0,0,8,0"
                                Background="{Binding ActiveTab.Accent}" />
                        <TextBlock Text="{Binding ActiveTab.Profile.Name}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}" />
                        <TextBlock x:Name="TxtBranch"
                                   Text="{Binding ActiveTab.Branch}"
                                   Margin="10,0,0,0"
                                   Foreground="{StaticResource Text.Disabled}"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}" />
                    </StackPanel>

                    <TextBlock x:Name="TxtDetail"
                               Grid.Column="1"
                               Text="{Binding ActiveTab.StatusDetail}"
                               Margin="18,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Disabled}"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Small}" />

                    <!-- Transient message (command results, explain); takes the detail slot for a few seconds. -->
                    <TextBlock x:Name="TxtMessage"
                               Grid.Column="1"
                               Margin="18,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text.Secondary}"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Visibility="Collapsed" />

                    <!-- Link under the pointer while Ctrl is held; takes the detail slot. -->
                    <StackPanel x:Name="LinkHintPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="18,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="&#xE71B;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="10"
                                   Margin="0,1,7,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock x:Name="TxtLinkHint"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Herd counts: click jumps to the tab that needs you (tab.jumpToAttention). -->
                        <TextBlock x:Name="TxtAttention"
                                   Margin="0,0,18,0"
                                   Cursor="Hand"
                                   ToolTip="Jump to the tab that needs you  (Ctrl+Shift+J)"
                                   Foreground="{StaticResource Text.Disabled}"
                                   FontFamily="{StaticResource Font.Ui}"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   MouseLeftButtonDown="Attention_Click" />
                        <TextBlock x:Name="TxtGrid"
                                   Foreground="{StaticResource Text.Disabled}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource Font.Size.Small}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
