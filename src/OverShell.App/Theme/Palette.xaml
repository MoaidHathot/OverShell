<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================ Palette ============================ -->
    <!-- Cool neutral greys. Kept a touch blue so it reads as intentional
         rather than "default WPF grey", and stays calm next to terminal colour. -->

    <Color x:Key="Surface.BaseColor">#FF101216</Color>
    <Color x:Key="Surface.ChromeColor">#FF171A20</Color>
    <Color x:Key="Surface.RaisedColor">#FF1E222A</Color>
    <Color x:Key="Surface.HoverColor">#FF262B34</Color>
    <Color x:Key="Surface.PressedColor">#FF2E343E</Color>
    <Color x:Key="Surface.BorderColor">#FF262A33</Color>

    <Color x:Key="Text.PrimaryColor">#FFE8EAED</Color>
    <Color x:Key="Text.SecondaryColor">#FF9AA3B0</Color>
    <Color x:Key="Text.DisabledColor">#FF5C646F</Color>

    <Color x:Key="Accent.BaseColor">#FF4C8DFF</Color>
    <Color x:Key="Accent.MutedColor">#FF2E5FB0</Color>
    <Color x:Key="Danger.BaseColor">#FFE5484D</Color>

    <SolidColorBrush x:Key="Surface.Base" Color="{StaticResource Surface.BaseColor}" />
    <SolidColorBrush x:Key="Surface.Chrome" Color="{StaticResource Surface.ChromeColor}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Surface.RaisedColor}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Surface.HoverColor}" />
    <SolidColorBrush x:Key="Surface.Pressed" Color="{StaticResource Surface.PressedColor}" />
    <SolidColorBrush x:Key="Surface.Border" Color="{StaticResource Surface.BorderColor}" />

    <!--
      Chrome surfaces used when a system backdrop is active. Fully transparent chrome
      would leave tab labels unreadable over a light wallpaper, so these keep a tint
      dense enough for text contrast while still letting the blur through.
      MainWindow falls back to the opaque brushes above if the backdrop is unavailable.
    -->
    <SolidColorBrush x:Key="Surface.ChromeTranslucent" Color="#A6171A20" />
    <SolidColorBrush x:Key="Surface.StatusTranslucent" Color="#A6171A20" />

    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.PrimaryColor}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.SecondaryColor}" />
    <SolidColorBrush x:Key="Text.Disabled" Color="{StaticResource Text.DisabledColor}" />

    <SolidColorBrush x:Key="Accent.Base" Color="{StaticResource Accent.BaseColor}" />
    <SolidColorBrush x:Key="Accent.Muted" Color="{StaticResource Accent.MutedColor}" />
    <SolidColorBrush x:Key="Danger.Base" Color="{StaticResource Danger.BaseColor}" />

    <SolidColorBrush x:Key="Transparent" Color="Transparent" />

    <!-- Agent states (§12.5). Amber for "needs you" and green for "done" are the two the eye
         must separate at a glance in a strip of twelve tabs; working reuses the accent. -->
    <Color x:Key="State.WorkingColor">#FF4C8DFF</Color>
    <Color x:Key="State.BlockedColor">#FFF5A524</Color>
    <Color x:Key="State.DoneColor">#FF3DD68C</Color>
    <Color x:Key="State.ErrorColor">#FFE5484D</Color>
    <Color x:Key="State.IdleColor">#FF6B7480</Color>
    <Color x:Key="State.ExitedColor">#FF4A5058</Color>

    <SolidColorBrush x:Key="State.Working" Color="{StaticResource State.WorkingColor}" />
    <SolidColorBrush x:Key="State.Blocked" Color="{StaticResource State.BlockedColor}" />
    <SolidColorBrush x:Key="State.Done" Color="{StaticResource State.DoneColor}" />
    <SolidColorBrush x:Key="State.Error" Color="{StaticResource State.ErrorColor}" />
    <SolidColorBrush x:Key="State.Idle" Color="{StaticResource State.IdleColor}" />
    <SolidColorBrush x:Key="State.Exited" Color="{StaticResource State.ExitedColor}" />

    <!-- ========================== Typography =========================== -->

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="Font.Size.Body">12.5</sys:Double>
    <sys:Double x:Key="Font.Size.Small">11</sys:Double>
    <sys:Double x:Key="Font.Size.Detail">10.5</sys:Double>
    <sys:Double x:Key="Font.Size.Icon">11</sys:Double>

    <!-- ============================ Metrics =========================== -->

    <!-- Tall enough for the two-line tab item (label / state · project). -->
    <sys:Double x:Key="Metrics.TitleBarHeight">54</sys:Double>
    <sys:Double x:Key="Metrics.TabHeight">46</sys:Double>
    <sys:Double x:Key="Metrics.StatusBarHeight">26</sys:Double>
    <CornerRadius x:Key="Metrics.TabCorner">6,6,0,0</CornerRadius>

</ResourceDictionary>
