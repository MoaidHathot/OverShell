<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= Harness icons ========================= -->
    <!-- One vector per harness (DESIGN.md 12.13, 12.15), coloured by the theme brush of the
         text next to them, overridable by a skin (same key) or by a rule file
         ("icon": "<path data>"). HarnessIcon draws them at a whole number of device pixels.

         Two kinds, told apart by the geometry's bounds:
         - pixel art, on a grid of at most 8 units: every unit becomes a whole number of
           device pixels, so axis-aligned edges are razor sharp at any scale;
         - vectors on a 16-unit grid: the box is a whole number of pixels, the shape is
           anti-aliased - so they are solid and chunky, never thin outlines, which at 16 px
           read as a grey smudge (the first vector icons were, and the text glyphs before them).

         A "<key>.Muted" geometry, when present, is drawn with the same brush at reduced
         opacity through the same transform: a second tone for a two-tone mark. -->

    <!-- OpenCode: its own mark (packages/ui/src/assets/favicon/favicon.svg, MIT), a 4x5
         frame one unit thick with a 2x2 block in the lower part of the hole, drawn in a
         second tone; the slot above the block is what makes it the OpenCode mark. -->
    <Geometry x:Key="Harness.Icon.opencode">F0 M0,0 H4 V5 H0 Z M1,1 V4 H3 V1 Z</Geometry>
    <Geometry x:Key="Harness.Icon.opencode.Muted">M1,2 H3 V4 H1 Z</Geometry>

    <!-- Copilot CLI: a four-pointed sparkle with a solid body. -->
    <Geometry x:Key="Harness.Icon.copilot">M8,0 C9.4,4 12,6.6 16,8 C12,9.4 9.4,12 8,16 C6.6,12 4,9.4 0,8 C4,6.6 6.6,4 8,0 Z</Geometry>

    <!-- Claude Code: an eight-spoke asterisk, each spoke a 2.6-unit bar. -->
    <GeometryGroup x:Key="Harness.Icon.claude" FillRule="Nonzero">
        <RectangleGeometry Rect="6.7,0,2.6,16" />
        <RectangleGeometry Rect="0,6.7,16,2.6" />
        <RectangleGeometry Rect="6.7,0.8,2.6,14.4">
            <RectangleGeometry.Transform>
                <RotateTransform Angle="45" CenterX="8" CenterY="8" />
            </RectangleGeometry.Transform>
        </RectangleGeometry>
        <RectangleGeometry Rect="6.7,0.8,2.6,14.4">
            <RectangleGeometry.Transform>
                <RotateTransform Angle="-45" CenterX="8" CenterY="8" />
            </RectangleGeometry.Transform>
        </RectangleGeometry>
    </GeometryGroup>

    <!-- Codex: a thick ring with a dot. -->
    <Geometry x:Key="Harness.Icon.codex">F0 M8,0 A8,8 0 1 1 7.99,0 Z M8,2.8 A5.2,5.2 0 1 0 8.01,2.8 Z M8,5.4 A2.6,2.6 0 1 1 7.99,5.4 Z</Geometry>

    <!-- Any other agent: a filled diamond. -->
    <Geometry x:Key="Harness.Icon.generic">M8,0 L16,8 L8,16 L0,8 Z</Geometry>

</ResourceDictionary>
