<UserControl x:Class="OverShell.App.Chrome.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OverShell.App"
             Focusable="False"
             Background="{StaticResource Surface.Base}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="8">
        <ItemsControl x:Name="Cards" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:TerminalTab}">
                    <!-- One card per tab (§12.5): header, body from UIA text in the tab's own
                         colours, footer. Never a live scaled-down terminal — that would reflow
                         the agent's PTY (§12.7, spike 6). -->
                    <Border x:Name="Card"
                            Width="420"
                            Height="300"
                            Margin="8"
                            CornerRadius="10"
                            Background="{StaticResource Surface.Raised}"
                            BorderBrush="{StaticResource Surface.Border}"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <DockPanel>
                            <!-- header -->
                            <Grid DockPanel.Dock="Top" Margin="14,10,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Border x:Name="BlockedRing" Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" BorderBrush="{StaticResource State.Blocked}" Visibility="Collapsed" />
                                    <Border x:Name="StateDot" Width="8" Height="8" CornerRadius="4" Background="{Binding StateBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" Visibility="Collapsed" />
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                                        <Border x:Name="UnreadBadge" Width="6" Height="6" Margin="6,0,0,0" CornerRadius="3" VerticalAlignment="Center" Background="{Binding StateBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProjectAndBranch}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Detail}" Foreground="{StaticResource Text.Disabled}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE8A7;" ToolTip="Open in the terminal view" Style="{StaticResource ChromeIconButton}" Click="Open_Click" />
                            </Grid>

                            <!-- footer -->
                            <Grid DockPanel.Dock="Bottom" Margin="14,6,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FooterState" Text="{Binding StateText}" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Small}" Foreground="{StaticResource Text.Secondary}" />
                                    <TextBlock Text="{Binding Summary}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="240" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Small}" Foreground="{StaticResource Text.Disabled}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ActivityText}" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Small}" Foreground="{StaticResource Text.Disabled}" />
                                <ProgressBar x:Name="Progress" Grid.ColumnSpan="2" Height="2" Margin="0,0,0,-6" VerticalAlignment="Bottom" Minimum="0" Maximum="1"
                                             Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                             Foreground="{Binding StateBrush}" Background="Transparent" BorderThickness="0" Visibility="Collapsed" />
                            </Grid>

                            <!-- body: the last rows of the screen in the tab's colours -->
                            <Border Margin="10,0" CornerRadius="6" Background="{Binding Background}" ClipToBounds="True">
                                <TextBlock Text="{Binding ScreenText}"
                                           Margin="10,8"
                                           VerticalAlignment="Bottom"
                                           TextWrapping="NoWrap"
                                           TextTrimming="None"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11"
                                           LineHeight="15"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{Binding Foreground}" />
                            </Border>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Accent}" />
                        </DataTrigger>
                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource Surface.Hover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsAgent}" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Blocked">
                            <Setter TargetName="BlockedRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FooterState" Property="Foreground" Value="{StaticResource State.Blocked}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Done">
                            <Setter TargetName="FooterState" Property="Foreground" Value="{StaticResource State.Done}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Error">
                            <Setter TargetName="FooterState" Property="Foreground" Value="{StaticResource State.Error}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Unread}" Value="True">
                            <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProgressIndeterminate}" Value="True">
                            <Setter TargetName="Progress" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Progress, Converter={StaticResource IsNotNull}}" Value="True">
                            <Setter TargetName="Progress" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
