<Window x:Class="OverShell.App.Chrome.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:OverShell.App.Chrome"
        Title="OverShell palette"
        Width="620"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="{StaticResource Surface.Raised}"
            BorderBrush="{StaticResource Surface.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="14,12,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtPrompt"
                           Grid.Column="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Icons}"
                           FontSize="13"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="&#xE721;" />

                <TextBox x:Name="Input"
                         Grid.Column="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource Text.Primary}"
                         CaretBrush="{StaticResource Text.Primary}"
                         FontFamily="{StaticResource Font.Ui}"
                         FontSize="15"
                         Padding="0"
                         VerticalContentAlignment="Center"
                         TextChanged="Input_TextChanged"
                         PreviewKeyDown="Input_PreviewKeyDown" />
            </Grid>

            <Border Height="1" Background="{StaticResource Surface.Border}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="List"
                     Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="6"
                     MaxHeight="420"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="List_SelectionChanged"
                     MouseLeftButtonUp="List_MouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="10,7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type chrome:PaletteItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="8" Height="8"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{Binding Dot}"
                                    Visibility="{Binding DotVisibility}" />
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Glyph}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Visibility="{Binding GlyphVisibility}" />

                            <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource Font.Ui}"
                                           FontSize="{StaticResource Font.Size.Body}"
                                           Foreground="{StaticResource Text.Primary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}"
                                           FontFamily="{StaticResource Font.Ui}"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           Foreground="{StaticResource Text.Secondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DetailVisibility}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Hint}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Foreground="{StaticResource Text.Disabled}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

                <!-- Screen preview of the selected tab (switcher only): the last rows, in
                     monospace, read through UIA — never a live terminal (§12.7, spike 6). -->
                <Border x:Name="Preview"
                        Grid.Column="1"
                        Margin="0,6,6,6"
                        CornerRadius="6"
                        Background="{StaticResource Surface.Base}"
                        BorderBrush="{StaticResource Surface.Border}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtPreview"
                               Margin="10,8"
                               VerticalAlignment="Bottom"
                               TextWrapping="NoWrap"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="10.5"
                               LineHeight="14"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource Text.Secondary}" />
                </Border>
            </Grid>

            <TextBlock x:Name="TxtEmpty"
                       Margin="16,4,16,12"
                       FontFamily="{StaticResource Font.Ui}"
                       FontSize="{StaticResource Font.Size.Small}"
                       Foreground="{StaticResource Text.Disabled}"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
