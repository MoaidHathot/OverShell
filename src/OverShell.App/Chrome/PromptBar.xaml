<UserControl x:Class="OverShell.App.Chrome.PromptBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             AllowDrop="True"
             PreviewDragOver="Transfer_DragOver"
             PreviewDrop="Transfer_Drop">

    <Border Background="{StaticResource Surface.Chrome}"
            BorderBrush="{StaticResource Surface.Border}"
            BorderThickness="0,1,0,0"
            Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- who gets the text -->
            <ComboBox x:Name="Target"
                      Grid.Column="0"
                      Width="150"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      FontFamily="{StaticResource Font.Ui}"
                      FontSize="{StaticResource Font.Size.Small}"
                      ToolTip="Where the prompt goes">
                <ComboBoxItem Content="Active tab" Tag="active" IsSelected="True" />
                <ComboBoxItem Content="All agents" Tag="agents" />
                <ComboBoxItem Content="Agents needing you" Tag="blocked" />
                <ComboBoxItem Content="This tab's group" Tag="group" />
                <ComboBoxItem Content="Every tab" Tag="all" />
            </ComboBox>

            <Border Grid.Column="1"
                    Background="{StaticResource Surface.Base}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4">
                <StackPanel>
                    <TextBox x:Name="Input"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource Text.Primary}"
                             CaretBrush="{StaticResource Text.Primary}"
                             FontFamily="{StaticResource Font.Ui}"
                             FontSize="{StaticResource Font.Size.Body}"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             MaxLines="6"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             TextChanged="Input_TextChanged"
                              PreviewKeyDown="Input_PreviewKeyDown" />
                    <ItemsControl x:Name="AttachmentItems" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface.Chrome}" CornerRadius="4" Margin="0,0,6,4" Padding="6,2" ToolTip="{Binding Path}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Text.Primary}" FontSize="{StaticResource Font.Size.Small}" />
                                        <Button Content="&#xE711;" Margin="4,0,0,0" ToolTip="Remove attachment" Click="RemoveAttachment_Click"
                                                Style="{StaticResource ChromeIconButton}" AutomationProperties.Name="Remove attachment" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TransferError" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,2,0,0"
                               Foreground="{StaticResource State.Error}" FontSize="{StaticResource Font.Size.Small}" />
                    <!-- Where an addressed prompt (@3, #group, @label) will go, echoed before Enter. -->
                    <TextBlock x:Name="Route"
                               Margin="2,2,0,0"
                               Visibility="Collapsed"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Detail}"
                               Foreground="{StaticResource Accent.Base}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Button x:Name="BtnAttach"
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    Content="&#xE723;"
                    ToolTip="Attach files (any type); paste or drop also accepts folders and media"
                    Style="{StaticResource ChromeIconButton}"
                    Click="Attach_Click" />
            <Button x:Name="BtnSnippets"
                    Grid.Column="3"
                    Margin="2,0,0,0"
                    Content="&#xE8FD;"
                    ToolTip="Snippets (snippets.jsonc)"
                    Style="{StaticResource ChromeIconButton}"
                    Click="Snippets_Click" />
            <Button x:Name="BtnSend"
                    Grid.Column="4"
                    Margin="2,0,0,0"
                    Content="&#xE724;"
                    ToolTip="Send  (Enter; Shift+Enter for a new line)"
                    Style="{StaticResource ChromeIconButton}"
                    Click="Send_Click" />
            <Button Grid.Column="5"
                    Margin="2,0,0,0"
                    Content="&#xE8BB;"
                    FontSize="9"
                    ToolTip="Hide  (Esc)"
                    Style="{StaticResource ChromeIconButton}"
                    Click="Hide_Click" />
        </Grid>
    </Border>
</UserControl>
