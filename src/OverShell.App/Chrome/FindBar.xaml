<UserControl x:Class="OverShell.App.Chrome.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <UserControl.Resources>
        <!-- The match-case switch: a small toggle that reads like the icon buttons beside it. -->
        <Style x:Key="FindToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent.Base}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Surface.Chrome}"
            BorderBrush="{StaticResource Surface.Border}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="&#xE721;"
                       Margin="2,0,10,0"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Icons}"
                       FontSize="{StaticResource Font.Size.Icon}"
                       Foreground="{StaticResource Text.Secondary}" />

            <Border Grid.Column="1"
                    Width="320"
                    Background="{StaticResource Surface.Base}"
                    BorderBrush="{StaticResource Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,3">
                <Grid>
                    <TextBox x:Name="Input"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource Text.Primary}"
                             CaretBrush="{StaticResource Text.Primary}"
                             FontFamily="{StaticResource Font.Ui}"
                             FontSize="{StaticResource Font.Size.Body}"
                             AcceptsReturn="False"
                             AcceptsTab="False"
                             TextChanged="Input_TextChanged"
                             PreviewKeyDown="Input_PreviewKeyDown" />
                    <TextBlock x:Name="Placeholder"
                               Text="Find in this tab"
                               Margin="2,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Body}"
                               Foreground="{StaticResource Text.Disabled}" />
                </Grid>
            </Border>

            <Button x:Name="BtnUp"
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    Content="&#xE70E;"
                    ToolTip="Older match, upwards  (Enter, F3)"
                    Style="{StaticResource ChromeIconButton}"
                    Click="Up_Click" />
            <Button x:Name="BtnDown"
                    Grid.Column="3"
                    Margin="2,0,0,0"
                    Content="&#xE70D;"
                    ToolTip="Newer match, downwards  (Shift+Enter, Shift+F3)"
                    Style="{StaticResource ChromeIconButton}"
                    Click="Down_Click" />

            <ToggleButton x:Name="MatchCase"
                          Grid.Column="4"
                          Margin="8,0,0,0"
                          Content="Aa"
                          ToolTip="Match case"
                          Style="{StaticResource FindToggle}"
                          Checked="MatchCase_Changed"
                          Unchecked="MatchCase_Changed" />

            <TextBlock x:Name="Status"
                       Grid.Column="5"
                       Margin="12,0,8,0"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Ui}"
                       FontSize="{StaticResource Font.Size.Small}"
                       Foreground="{StaticResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="6"
                    Margin="2,0,0,0"
                    Content="&#xE8BB;"
                    FontSize="9"
                    ToolTip="Close  (Esc)"
                    Style="{StaticResource ChromeIconButton}"
                    Click="Close_Click" />
        </Grid>
    </Border>
</UserControl>
