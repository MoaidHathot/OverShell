<UserControl x:Class="OverShell.App.Chrome.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:OverShell.App"
             Focusable="False"
             shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <UserControl.Resources>
        <!-- Shared pieces of every tab item: the state dot with its blocked ring, and the
             triggers that colour it. The three templates below differ in arrangement only. -->
        <Style x:Key="TabRootStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource Metrics.TabCorner}" />
        </Style>

        <!-- Group headers (tab.moveToGroup): a name before the group's tabs. Tabs without a
             group form an unnamed group whose header collapses. -->
        <GroupStyle x:Key="StripGroupStyle">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Header" Margin="6,0,4,6" VerticalAlignment="Bottom" BorderBrush="{StaticResource Surface.Border}" BorderThickness="0,0,0,2" Padding="4,0,4,2">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Detail}" Foreground="{StaticResource Text.Disabled}" />
                                    </Border>
                                    <ItemsPresenter />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                        <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
            <GroupStyle.Panel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GroupStyle.Panel>
        </GroupStyle>

        <GroupStyle x:Key="ListGroupStyle">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="Header" Text="{Binding Name}" Margin="14,8,8,2" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Detail}" FontWeight="SemiBold" Foreground="{StaticResource Text.Disabled}" />
                                    <ItemsPresenter />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                        <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
            <GroupStyle.Panel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </GroupStyle.Panel>
        </GroupStyle>

        <!-- ================= strip: horizontal, two lines (caption / bottom) ================= -->
        <DataTemplate x:Key="StripTemplate" DataType="{x:Type local:TerminalTab}">
            <Border x:Name="TabRoot"
                    Style="{StaticResource TabRootStyle}"
                    MinWidth="150"
                    MaxWidth="240"
                    Height="{StaticResource Metrics.TabHeight}"
                    Margin="0,0,2,0"
                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                    MouseDown="Tab_MouseDown"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <Border x:Name="ActiveBar" Height="2" VerticalAlignment="Top" Margin="10,0" CornerRadius="1" Background="{Binding Accent}" Visibility="Collapsed" />
                    <Grid Margin="11,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border x:Name="BlockedRing" Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" BorderBrush="{StaticResource State.Blocked}" Visibility="Collapsed" />
                            <Border x:Name="StateDot" Width="8" Height="8" CornerRadius="4" Background="{Binding Accent}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TabGlyph" Text="{Binding Glyph}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Text.Secondary}" Visibility="Collapsed" />
                                <TextBlock x:Name="TabLabel" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}" Foreground="{StaticResource Text.Secondary}" />
                                <Border x:Name="UnreadBadge" Width="6" Height="6" Margin="6,0,0,0" CornerRadius="3" VerticalAlignment="Center" Background="{Binding StateBrush}" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="TabDetail" Text="{Binding Detail}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Detail}" Foreground="{StaticResource Text.Disabled}" />
                        </StackPanel>
                        <Button x:Name="TabClose" Grid.Column="2" Width="20" Height="20" Margin="7,0,0,0" Content="&#xE8BB;" FontSize="8" Opacity="0" Style="{StaticResource ChromeIconButton}" Click="CloseTab_Click" />
                    </Grid>
                    <ProgressBar x:Name="TabProgress" Height="2" Margin="10,0,10,1" VerticalAlignment="Bottom" Minimum="0" Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                 Foreground="{Binding StateBrush}" Background="Transparent" BorderThickness="0" Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{Binding Background}" />
                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Primary}" />
                    <Setter TargetName="TabLabel" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource Text.Secondary}" />
                    <Setter TargetName="TabClose" Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabClose" Property="Opacity" Value="1" />
                    <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Primary}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="False" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Surface.Hover}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                    <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Disabled}" />
                    <Setter TargetName="TabLabel" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAgent}" Value="True">
                    <Setter TargetName="TabGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Working}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="WorkingPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="WorkingPulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Blocked">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Blocked}" />
                    <Setter TargetName="BlockedRing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Blocked}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Done}" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Done}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Error}" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Idle">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Idle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Exited">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Exited}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Unread}" Value="True">
                    <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProgressIndeterminate}" Value="True">
                    <Setter TargetName="TabProgress" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Progress, Converter={StaticResource IsNotNull}}" Value="True">
                    <Setter TargetName="TabProgress" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= list: vertical, two lines, full width (left / right) ================= -->
        <DataTemplate x:Key="ListTemplate" DataType="{x:Type local:TerminalTab}">
            <Border x:Name="TabRoot"
                    Background="Transparent"
                    CornerRadius="6"
                    Height="{StaticResource Metrics.TabHeight}"
                    Margin="6,1"
                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                    MouseDown="Tab_MouseDown"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <Border x:Name="ActiveBar" Width="2" HorizontalAlignment="Left" Margin="0,10" CornerRadius="1" Background="{Binding Accent}" Visibility="Collapsed" />
                    <Grid Margin="12,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border x:Name="BlockedRing" Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" BorderBrush="{StaticResource State.Blocked}" Visibility="Collapsed" />
                            <Border x:Name="StateDot" Width="8" Height="8" CornerRadius="4" Background="{Binding Accent}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TabGlyph" Text="{Binding Glyph}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Text.Secondary}" Visibility="Collapsed" />
                                <TextBlock x:Name="TabLabel" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}" Foreground="{StaticResource Text.Secondary}" />
                                <Border x:Name="UnreadBadge" Width="6" Height="6" Margin="6,0,0,0" CornerRadius="3" VerticalAlignment="Center" Background="{Binding StateBrush}" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="TabDetail" Text="{Binding Detail}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Detail}" Foreground="{StaticResource Text.Disabled}" />
                        </StackPanel>
                        <Button x:Name="TabClose" Grid.Column="2" Width="20" Height="20" Margin="4,0,0,0" Content="&#xE8BB;" FontSize="8" Opacity="0" Style="{StaticResource ChromeIconButton}" Click="CloseTab_Click" />
                    </Grid>
                    <ProgressBar x:Name="TabProgress" Height="2" Margin="12,0,10,2" VerticalAlignment="Bottom" Minimum="0" Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                 Foreground="{Binding StateBrush}" Background="Transparent" BorderThickness="0" Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Surface.Raised}" />
                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Primary}" />
                    <Setter TargetName="TabLabel" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource Text.Secondary}" />
                    <Setter TargetName="TabClose" Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabClose" Property="Opacity" Value="1" />
                    <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Primary}" />
                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Surface.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                    <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource Text.Disabled}" />
                    <Setter TargetName="TabLabel" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAgent}" Value="True">
                    <Setter TargetName="TabGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Working}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="WorkingPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="WorkingPulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Blocked">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Blocked}" />
                    <Setter TargetName="BlockedRing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Blocked}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Done}" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Done}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Error}" />
                    <Setter TargetName="TabDetail" Property="Foreground" Value="{StaticResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Idle">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Idle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Exited">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Exited}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Unread}" Value="True">
                    <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProgressIndeterminate}" Value="True">
                    <Setter TargetName="TabProgress" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Progress, Converter={StaticResource IsNotNull}}" Value="True">
                    <Setter TargetName="TabProgress" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= rail: dot and glyph only; the label lives in the tooltip ================= -->
        <DataTemplate x:Key="RailTemplate" DataType="{x:Type local:TerminalTab}">
            <Border x:Name="TabRoot"
                    Background="Transparent"
                    CornerRadius="6"
                    Width="40" Height="40"
                    Margin="4,2"
                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                    MouseDown="Tab_MouseDown"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <Border x:Name="ActiveBar" Width="2" HorizontalAlignment="Left" Margin="0,10" CornerRadius="1" Background="{Binding Accent}" Visibility="Collapsed" />
                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="BlockedRing" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" BorderBrush="{StaticResource State.Blocked}" Visibility="Collapsed" />
                        <Border x:Name="StateDot" Width="10" Height="10" CornerRadius="5" Background="{Binding Accent}" />
                    </Grid>
                    <TextBlock x:Name="TabGlyph" Text="{Binding Glyph}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,3" FontSize="10" Foreground="{StaticResource Text.Secondary}" Visibility="Collapsed" />
                    <Border x:Name="UnreadBadge" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" CornerRadius="3" Background="{Binding StateBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Surface.Raised}" />
                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Surface.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsAgent}" Value="True">
                    <Setter TargetName="TabGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Working}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="WorkingPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="WorkingPulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Blocked">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Blocked}" />
                    <Setter TargetName="BlockedRing" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Done}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Idle">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Idle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Exited">
                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource State.Exited}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Unread}" Value="True">
                    <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Left">
        <StackPanel x:Name="Row" Orientation="Horizontal">
            <ItemsControl x:Name="Items" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel x:Name="Actions" Orientation="Horizontal">
                <Button x:Name="BtnNewTab" Content="&#xE710;" Margin="4,0,0,1" VerticalAlignment="Center" ToolTip="New tab  (Ctrl+T)" Style="{StaticResource ChromeIconButton}" Click="NewTab_Click" />
                <Button x:Name="BtnProfiles" Content="&#xE70D;" FontSize="9" Width="22" Margin="1,0,0,1" VerticalAlignment="Center" ToolTip="Open a specific profile" Style="{StaticResource ChromeIconButton}" Click="Profiles_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
