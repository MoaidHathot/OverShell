<UserControl x:Class="OverShell.App.Chrome.ViewSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Focusable="False"
             shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <UserControl.Resources>
        <Style x:Key="ViewButton" TargetType="Button" BasedOn="{StaticResource ChromeIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </UserControl.Resources>

    <!-- One button per view; the current one is raised. The badge counts tabs needing you
         and sits on the Herd button, which is where you would go to see them. -->
    <Border Background="{StaticResource Surface.Base}" CornerRadius="7" Padding="3,2" Margin="0,0,10,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnTerminal" Style="{StaticResource ViewButton}" Content="&#xE756;" ToolTip="Terminal  (Ctrl+Shift+1)" Tag="terminal" Click="View_Click" />
            <Grid>
                <Button x:Name="BtnHerd" Style="{StaticResource ViewButton}" Content="&#xE716;" ToolTip="Herd  (Ctrl+Shift+2)" Tag="herd" Click="View_Click" />
                <Border x:Name="Badge"
                        MinWidth="14" Height="14"
                        Padding="3,0"
                        CornerRadius="7"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-3,-4,0"
                        Background="{StaticResource State.Blocked}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtBadge"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#FF0B1020"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <Button x:Name="BtnDashboard" Style="{StaticResource ViewButton}" Content="&#xF0E2;" ToolTip="Dashboard  (Ctrl+Shift+3)" Tag="dashboard" Click="View_Click" />
            <Button x:Name="BtnZen" Style="{StaticResource ViewButton}" Content="&#xE740;" ToolTip="Zen  (Ctrl+Shift+4)" Tag="zen" Click="View_Click" />
        </StackPanel>
    </Border>
</UserControl>
