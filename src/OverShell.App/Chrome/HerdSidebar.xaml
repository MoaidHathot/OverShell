<UserControl x:Class="OverShell.App.Chrome.HerdSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="clr-namespace:OverShell.App.Chrome"
             xmlns:local="clr-namespace:OverShell.App"
             Focusable="False"
             Background="{StaticResource Surface.Chrome}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Herd"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Body}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}" />
                <TextBlock x:Name="TxtSummary"
                           Grid.Column="1"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{StaticResource Text.Disabled}" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="Groups" Focusable="False" Margin="6,0,6,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type chrome:HerdGroupView}">
                        <StackPanel Margin="0,4,0,6">
                            <!-- project header with the group's worst state -->
                            <Grid Margin="8,2,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding RollupBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Project}"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource Font.Ui}"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Secondary}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Summary}"
                                           FontFamily="{StaticResource Font.Ui}"
                                           FontSize="{StaticResource Font.Size.Detail}"
                                           Foreground="{StaticResource Text.Disabled}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TerminalTab}">
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Margin="0,1"
                                                Cursor="Hand"
                                                ToolTip="{Binding Tooltip}"
                                                MouseLeftButtonDown="Row_MouseLeftButtonDown"
                                                MouseRightButtonUp="Row_MouseRightButtonUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Border x:Name="BlockedRing" Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" BorderBrush="{StaticResource State.Blocked}" Visibility="Collapsed" />
                                                    <Border x:Name="StateDot" Width="8" Height="8" CornerRadius="4" Background="{Binding StateBrush}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Margin="0,0,5,0" FontSize="11" Foreground="{StaticResource Text.Secondary}" Visibility="Collapsed" />
                                                        <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}" Foreground="{StaticResource Text.Primary}" />
                                                        <Border x:Name="UnreadBadge" Width="6" Height="6" Margin="6,0,0,0" CornerRadius="3" VerticalAlignment="Center" Background="{Binding StateBrush}" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="Detail" Text="{Binding SidebarDetail}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Size.Detail}" Foreground="{StaticResource Text.Disabled}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ActivityText}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Top"
                                                           FontFamily="{StaticResource Font.Ui}"
                                                           FontSize="{StaticResource Font.Size.Detail}"
                                                           Foreground="{StaticResource Text.Disabled}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface.Raised}" />
                                            </DataTrigger>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface.Hover}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsAgent}" Value="True">
                                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Blocked">
                                                <Setter TargetName="BlockedRing" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource State.Blocked}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Done">
                                                <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource State.Done}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource State.Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Unread}" Value="True">
                                                <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text.Disabled}" />
                                                <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
