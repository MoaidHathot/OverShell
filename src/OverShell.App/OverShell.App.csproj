<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>OverShell.App</RootNamespace>
    <AssemblyName>OverShell</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport with raw pointers in the ConPTY interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Microsoft.Windows.Console.ConPTY copies an OpenConsole.exe per host architecture it
      thinks an x64 process might run on. conpty.dll looks for <dir>\OpenConsole.exe, then
      <dir>\<arch>\OpenConsole.exe, then falls back to the in-box conhost.exe. We ship the
      x64 one only: the app is win-x64 and never runs under ARM64 emulation in practice.
    -->
    <ConptyRequiresARM64Host>false</ConptyRequiresARM64Host>
  </PropertyGroup>

  <!--
    ================================ .NET tool package =================================
    `dotnet tool install -g OverShell` / `dnx OverShell` (DESIGN.md §13). The SDK refuses
    to pack a tool whose TFM carries a platform (NETSDK1146) - and WPF needs
    net10.0-windows. The tool is inherently Windows-only, so the platform is blanked for
    the pack validation and the package folder comes out as tools/net10.0/win-x64/, which
    is what `dotnet tool install` looks for. RID-specific with an apphost, so the tool
    settings name OverShell.exe (the GUI apphost) as the entry point.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>overshell</ToolCommandName>
    <PackageId>OverShell</PackageId>
    <Description>Overseer Shell - a Windows terminal built on the Windows Terminal engine that watches the AI coding agents in its tabs: who is working, who needs you, who finished.</Description>
    <PackageTags>terminal;windows-terminal;ai-agents;opencode;copilot-cli;claude-code;codex;wpf</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MoaidHathot/OverShell</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="OverShellAllowWindowsToolPack" BeforeTargets="_PackToolValidation">
    <PropertyGroup>
      <TargetPlatformIdentifier />
      <TargetPlatformMoniker />
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- Microsoft.Terminal.Wpf.dll (managed HwndHost) + Microsoft.Terminal.Control.dll (native). -->
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" />
    <!-- conpty.dll + OpenConsole.exe, the same pseudoconsole host Windows Terminal ships. -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OverShell.Config\OverShell.Config.csproj" />
    <ProjectReference Include="..\OverShell.Core\OverShell.Core.csproj" />
  </ItemGroup>

</Project>
