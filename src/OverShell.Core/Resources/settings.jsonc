// OverShell default settings.
//
// Copy only what you want to change into %APPDATA%\OverShell\settings.jsonc. Objects merge
// key by key; arrays replace as a whole; setting a key to null removes it. Sinks are named
// so that enabling one is a one-liner:
//
//   { "notifications": { "sinks": { "palantir": { "enabled": true } } } }
{
  // The view shown at start: terminal | herd | dashboard | zen.
  "view": "terminal",

  // A view is a layout (a preset name or a file under %APPDATA%\OverShell\layouts\) plus
  // what the middle shows: "terminal" (the live tab) or "dashboard" (one card per tab).
  // Ctrl+Shift+1..4 switch; Ctrl+Shift+` toggles between the last two.
  "views": {
    "terminal":  { "layout": "top",       "content": "terminal",  "title": "Terminal" },
    "herd":      { "layout": "herd",      "content": "terminal",  "title": "Herd" },
    "dashboard": { "layout": "dashboard", "content": "dashboard", "title": "Dashboard" },
    "zen":       { "layout": "zen",       "content": "terminal",  "title": "Zen" }
  },

  "detection": {
    "snapshotDebounceMs": 300,
    "snapshotMinIntervalMs": 300,
    "processProbeIntervalMs": 2500,
    "treatUnknownAsAgent": false
  },

  // Branch comes from .git/HEAD (free). The dirty marker runs `git status` per repository
  // every statusIntervalMs and is off by default because it spawns a process.
  "git": {
    "branch": true,
    "dirty": false,
    "statusIntervalMs": 10000
  },

  // What comes back after a restart: the tabs (profile, directory, label, group) and the
  // view; for a tab whose agent left a session id, its resume command is typed once the
  // shell is ready (e.g. `opencode --session <id>`).
  "session": {
    "restore": true,
    "resumeAgents": true
  },

  // Registers overshell:// for this user at start (HKCU, no elevation), so a clicked
  // toast (--launch overshell://focus/<tab>) lands on its tab in the running window.
  "protocol": {
    "register": true
  },

  // A ResourceDictionary under %APPDATA%\OverShell\skins\<name>.xaml overriding theme keys
  // (Surface.Chrome, Accent.Base, State.Blocked, Font.Ui, Metrics.TabHeight, ...). Brush
  // colours update live when the file is saved; fonts and metrics apply at the next start.
  "skin": null,

  "notifications": {
    // Every enabled sink runs for every event its "when" allows. Kinds: blocked, done,
    // error, exited. Harnesses: opencode, copilot, claude, codex, generic, shell.
    "sinks": {
      // In-window toast over the terminal. Never for the tab you are looking at.
      "overlay": { "type": "overlay", "durationMs": 6000, "when": { "notActiveTab": true } },

      // Taskbar overlay badge with the number of tabs needing attention, plus a flash
      // when the window is not in the foreground.
      "taskbar": { "type": "taskbar" },

      // System sounds only while you are away from the window.
      "sound": {
        "type": "sound",
        "when": { "windowUnfocused": true },
        "sounds": { "blocked": "exclamation", "error": "hand", "done": "asterisk" }
      },

      // Windows toasts without an external program (Action Center, click focuses the tab).
      // Silent: the sound sink decides about sound. Off by default in favour of Palantir,
      // which does richer toasts; turn one or the other on, not both.
      "toast": { "type": "toast", "enabled": false, "when": { "notActiveTab": true } },

      // Windows toast through Palantir (https://github.com/MoaidHathot/Palantir).
      // {…} placeholders are filled from the event: kind, title, message, detail, time,
      // tab.id, tab.label, tab.harness, tab.harnessName, tab.project, tab.cwd.
      // Flags verified against palantir 2.0.1 --help. Clicking the toast opens
      // overshell://focus/<tab>, which the running window answers (protocol.register).
      "palantir": {
        "type": "command",
        "enabled": false,
        "exe": "palantir",
        "args": [
          "-t", "{title}",
          "-m", "{message}",
          "-b", "{tab.cwd}",
          "--tag", "overshell-{tab.id}",
          "--replace",
          "--launch", "overshell://focus/{tab.id}",
          "-q"
        ],
        "stdinJson": false,
        "when": { "notActiveTab": true }
      }
    }
  },

  "tabs": {
    "twoLine": true,
    "showHarnessGlyph": true
  }
}
