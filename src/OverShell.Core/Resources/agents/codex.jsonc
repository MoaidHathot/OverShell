// OpenAI Codex CLI — https://github.com/openai/codex
//
// [tui] notification_method = osc9 | bel gives OSC 9 / BEL on agent-turn-complete and
// approval-requested (suppressed while the terminal is focused unless focused_notifications).
// The external `notify` hook fires for agent-turn-complete only; OverShell wires it in P3.
{
  "id": "codex",
  "displayName": "Codex",
  "glyph": "◎",
  "detect": {
    "commandline": ["(^|[\\\\/\\s\"'])codex(\\.(exe|cmd|ps1))?(\\s|$|[\"'])"],
    "title": ["\\bCodex\\b"],
    "process": ["codex"]
  },
  "title": {},
  "screen": {
    "blocked": [
      "Allow command",
      "Approve",
      "don't ask again",
      "tell Codex what to do",
      "\\bYes \\(y\\)",
      "\\[y/N\\]"
    ],
    "working": ["\\bWorking\\b[^\\n]{0,20}\\besc\\b", "esc to interrupt", "\\bThinking\\b"],
    "idle": ["\\? for shortcuts", "⏎ send"]
  },
  "notification": {
    "blocked": ["approval", "approve", "permission"],
    "error": ["\\berror\\b", "\\bfailed\\b"],
    "done": ["turn complete", "\\bcomplete", "\\bfinished\\b"]
  },
  "idleAfterMs": 1500,
  "screenRows": 12,
  "resumeCommand": "codex resume {sessionId}",
  // Without a session id (no integration installed): the tool's own "most recent session" form.
  "resumeLastCommand": "codex resume --last",
  // What starts it in a shell. Its approval prompt takes y / n: from Codex's documentation,
  // not measured here.
  "launch": "codex",
  "answers": { "approve": "y", "deny": "n" }
}
