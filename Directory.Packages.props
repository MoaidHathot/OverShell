<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Windows Terminal WPF control, built from source by OverShell's fork of microsoft/terminal
      (https://github.com/MoaidHathot/terminal, branch overshell; build/overshell/README.md names the
      upstream commit and the patches). Version A.B.YYMMDD.N: upstream line A.B, upstream base commit
      date, fork revision. Until 1.25.260302.1 this was CI.Microsoft.Terminal.Wpf, a third party's
      repack of Microsoft's CI output (microsoft/terminal#15404 - there is no signed release of it).
        Microsoft.Terminal.Wpf.dll      managed HwndHost wrapper, ITerminalConnection
        Microsoft.Terminal.Control.dll  native - the real WT parser, buffer and AtlasEngine renderer
    -->
    <!-- Includes the checked Sixel palette lookup; docs/SIXEL-CRASH.md records the fix. -->
    <PackageVersion Include="OverShell.Terminal.Wpf" Version="1.26.260930.5" />
    <!--
      Microsoft's redistributable pseudoconsole: conpty.dll plus the OpenConsole.exe it
      launches, so ConPTY behaviour does not depend on the OS's conhost.exe.
    -->
    <PackageVersion Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260930003" />

    <!-- Tests only. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- 4.0.1 is on nuget.org but not yet on the proxy feeds the reference machine restores through (NU1102);
         a test runner's patch release is not worth a local build that cannot restore. Dependabot is told to
         skip that one version (.github/dependabot.yml); lift both when the feed has it. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
